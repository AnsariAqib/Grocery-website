{
    "name": "jaytulsi/agency-app",
    "type": "project",
    "description": "Jay Tulsi Agency & Vinayak Stores - Laravel Vue.js Application",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^4.0",
        "inertiajs/inertia-laravel": "^2.0 || ^1.0",
        "intervention/image": "*",
        "laravel/framework": "^11.0 || ^12.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php artisan filament:upgrade"
        ]
    }
}
